{
  "schemaVersion": "od-design-system-project/v1",
  "id": "claude",
  "name": "Claude (Anthropic) 3:4 Video",
  "category": "AI & LLM Video",
  "description": "Video-oriented Claude design package for 3:4 Remotion scenes, subtitles, title cards, quote frames, data callouts, and code/model-output overlays.",
  "source": {
    "type": "bundled",
    "origin": "Auto Vibe Motion curated video fixture"
  },
  "files": {
    "design": "DESIGN.md",
    "tokens": "tokens.css",
    "designTokens": "design-tokens.json",
    "tailwind": "tailwind-v4.css",
    "components": "components.html"
  },
  "usage": "USAGE.md",
  "componentsManifest": "components.manifest.json",
  "importMode": "normalized",
  "craft": {
    "applies": [
      "3:4-video",
      "subtitle-readability",
      "frame-safe-area"
    ],
    "suggested": [
      "color",
      "typography",
      "motion-composition"
    ],
    "exemptions": []
  },
  "preview": {
    "dir": "preview",
    "pages": [
      {
        "path": "preview/colors.html",
        "role": "colors",
        "title": "Colors"
      },
      {
        "path": "preview/typography.html",
        "role": "typography",
        "title": "Typography"
      },
      {
        "path": "preview/spacing.html",
        "role": "spacing",
        "title": "Spacing"
      }
    ]
  },
  "sourceFiles": {
    "evidence": "source/evidence.md",
    "tokens": "source/tokens.source.json",
    "report": "source/token-contract.report.json"
  }
